{
  "name": "ai-presentation-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "deploy:init": "prisma db push --accept-data-loss && tsx prisma/seed.ts",
    "test": "tsx tests/run.ts",
    "test:browser": "tsx tests/e2e-browser.ts",
    "preview": "tsx tests/preview.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@prisma/client": "^6.16.0",
    "@sparticuz/chromium": "^138.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "^1.1.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "jimp": "^1.6.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.11.0",
    "next": "15.5.28",
    "pdf-parse": "^1.1.4",
    "playwright-core": "1.58.2",
    "postcss": "^8.5.0",
    "pptxgenjs": "^4.0.1",
    "prisma": "^6.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
