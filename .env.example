DATABASE_URL="postgresql://studio:studio@localhost:5432/studio"
SESSION_SECRET="replace-with-a-long-random-string"
STORAGE_DIR="./storage"
# Nano Banana Pro (Gemini image model). Set this on the server only.
GEMINI_API_KEY=""
NANO_BANANA_MODEL="gemini-3-pro-image-preview"
# Optional: text model used for AI layout planning (structure only, never rewrites content)
GEMINI_TEXT_MODEL="gemini-2.5-flash"
